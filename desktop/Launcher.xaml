<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ascend Desktop" Width="760" Height="600" MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#08111E" Foreground="#E9F2FF"
        FontFamily="Segoe UI" FontSize="13">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="ASCEND" FontSize="24" FontWeight="SemiBold" Foreground="#8CCBFF"/>
      <TextBlock Text="Start each app independently. Slow startup stays visible here."
                 Foreground="#B8C9DC" Margin="0,4,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Background="#102137" BorderBrush="#31506E"
            BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <DockPanel>
          <TextBlock Text="VISION" FontWeight="SemiBold" FontSize="18" DockPanel.Dock="Left"/>
          <TextBlock x:Name="VisionState" Text="Stopped" Foreground="#8CCBFF"
                     HorizontalAlignment="Right"/>
        </DockPanel>
        <TextBlock x:Name="VisionStage" Text="Not started" Foreground="#D1DFEE"
                   Margin="0,9,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="VisionCapabilities" Text="" Foreground="#9EB4CC"
                   Margin="0,5,0,0" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,16,0,0">
          <Button x:Name="VisionStart" Content="Start Vision" MinWidth="96" Margin="0,0,8,7" Padding="10,6"/>
          <Button x:Name="VisionRecovery" Content="Chat recovery" MinWidth="102" Margin="0,0,8,7" Padding="10,6"/>
          <Button x:Name="VisionOpen" Content="Open Fairy" MinWidth="85" Margin="0,0,8,7" Padding="10,6"/>
          <Button x:Name="VisionStop" Content="Stop" MinWidth="58" Margin="0,0,8,7" Padding="10,6"/>
          <Button x:Name="VisionForce" Content="Cancel / Force stop" MinWidth="121" Margin="0,0,8,7" Padding="10,6"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#102137" BorderBrush="#31506E"
            BorderThickness="1" CornerRadius="10" Padding="16">
      <StackPanel>
        <DockPanel>
          <TextBlock Text="HUB" FontWeight="SemiBold" FontSize="18" DockPanel.Dock="Left"/>
          <TextBlock x:Name="HubState" Text="Stopped" Foreground="#8CCBFF"
                     HorizontalAlignment="Right"/>
        </DockPanel>
        <TextBlock x:Name="HubStage" Text="Not started" Foreground="#D1DFEE"
                   Margin="0,9,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="HubCapabilities" Text="" Foreground="#9EB4CC"
                   Margin="0,5,0,0" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,16,0,0">
          <Button x:Name="HubStart" Content="Start Hub" MinWidth="96" Margin="0,0,8,7" Padding="10,6"/>
          <Button x:Name="HubOpen" Content="Open Hub" MinWidth="85" Margin="0,0,8,7" Padding="10,6"/>
          <Button x:Name="HubStop" Content="Stop" MinWidth="58" Margin="0,0,8,7" Padding="10,6"/>
          <Button x:Name="HubForce" Content="Cancel / Force stop" MinWidth="121" Margin="0,0,8,7" Padding="10,6"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <DockPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock x:Name="ProfileStatus" Text="Profile loading..." Foreground="#A4BBCE"
                 DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <Button x:Name="Diagnostics" Content="Open diagnostics" HorizontalAlignment="Right"
              DockPanel.Dock="Right" Padding="10,6"/>
    </DockPanel>
  </Grid>
  </ScrollViewer>
</Window>
