<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ascend Vision" Width="520" Height="820" MinWidth="420" MinHeight="460" Background="{DynamicResource Base}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <!-- Same room as the Fairy window: a dark desk, an old monitor, mono for the machine. -->
      <SolidColorBrush x:Key="Base" Color="#05080D"/>
      <SolidColorBrush x:Key="Surface" Color="#12171E"/>
      <SolidColorBrush x:Key="Ink" Color="#D9E4EF"/>
      <SolidColorBrush x:Key="Secondary" Color="#93A6BA"/>
      <SolidColorBrush x:Key="Accent" Color="#9AA8FF"/>
      <SolidColorBrush x:Key="Edge" Color="#262E39"/>
      <SolidColorBrush x:Key="ActionInk" Color="#05080D"/>
      <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
      <Style x:Key="BootLabel" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Secondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <!-- The launcher script only sets the text; the colour follows the result. -->
      <Style x:Key="BootResult" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#627487"/>
        <Style.Triggers>
          <Trigger Property="Text" Value="Available"><Setter Property="Foreground" Value="#7DF0B4"/></Trigger>
          <Trigger Property="Text" Value="Starting"><Setter Property="Foreground" Value="#9AA8FF"/></Trigger>
          <Trigger Property="Text" Value="Disabled"><Setter Property="Foreground" Value="#93A6BA"/></Trigger>
          <Trigger Property="Text" Value="Sign-in required"><Setter Property="Foreground" Value="#FFB547"/></Trigger>
          <Trigger Property="Text" Value="Not configured"><Setter Property="Foreground" Value="#FFB547"/></Trigger>
          <Trigger Property="Text" Value="Unavailable"><Setter Property="Foreground" Value="#FF7A7A"/></Trigger>
          <Trigger Property="Text" Value="Request failed"><Setter Property="Foreground" Value="#FF7A7A"/></Trigger>
          <Trigger Property="Text" Value="Offline"><Setter Property="Foreground" Value="#FF7A7A"/></Trigger>
          <Trigger Property="Text" Value="Unreachable"><Setter Property="Foreground" Value="#FF7A7A"/></Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="Leader" TargetType="Line">
        <Setter Property="X2" Value="1"/>
        <Setter Property="Stretch" Value="Fill"/>
        <Setter Property="Stroke" Value="#2A3440"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeDashArray" Value="1 3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10,2,10,0"/>
      </Style>
      <DrawingBrush x:Key="Scanlines" TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute" Viewbox="0,0,4,3" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
          <GeometryDrawing Brush="#33000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,1"/></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingBrush.Drawing>
      </DrawingBrush>
    </ResourceDictionary>
  </Window.Resources>
  <ScrollViewer Background="{DynamicResource Base}" x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="Composition" Margin="28">
      <DockPanel Margin="0,0,0,16">
        <TextBlock DockPanel.Dock="Right" Text="ASCEND VISION" FontFamily="{DynamicResource Mono}" FontSize="10" Foreground="#627487" VerticalAlignment="Center"/>
        <TextBlock Text="F A I R Y" FontFamily="{DynamicResource Mono}" FontSize="16" FontWeight="SemiBold"/>
      </DockPanel>

      <!-- The monitor Fairy lives on. Artwork only: no camera, models or providers are touched. -->
      <Border CornerRadius="18,18,14,14" BorderBrush="#1E252F" BorderThickness="1" Padding="10,10,10,0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#171D25" Offset="0"/><GradientStop Color="#12171E" Offset="0.3"/><GradientStop Color="#0D1117" Offset="1"/></LinearGradientBrush>
        </Border.Background>
        <StackPanel>
          <Border CornerRadius="14" Height="250" ClipToBounds="True" AutomationProperties.Name="Fairy celestial eye">
            <Border.Background>
              <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.46" RadiusX="0.62" RadiusY="0.7">
                <GradientStop Color="#1B2580" Offset="0"/><GradientStop Color="#0A0F2A" Offset="0.45"/><GradientStop Color="#02060B" Offset="1"/>
              </RadialGradientBrush>
            </Border.Background>
            <Grid>
              <Viewbox Width="196" Height="196" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="400" Height="400">
                  <Canvas.Effect><DropShadowEffect Color="#3D4BFF" BlurRadius="46" ShadowDepth="0" Opacity="0.9"/></Canvas.Effect>
                  <Ellipse Canvas.Left="67" Canvas.Top="67" Width="266" Height="266" Fill="#0B1535" Stroke="#3D4BFF" StrokeThickness="4"/>
                  <!-- The iris glances around in quick darts and holds, like Fairy watching the room. -->
                  <Canvas Width="400" Height="400">
                    <Canvas.RenderTransform><TranslateTransform X="0" Y="0"/></Canvas.RenderTransform>
                    <Canvas.Triggers>
                      <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard><Storyboard RepeatBehavior="Forever">
                          <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Duration="0:0:7.2">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/><EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:1.52" Value="-26"/><EasingDoubleKeyFrame KeyTime="0:0:2.9" Value="-26"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:3.02" Value="22"/><EasingDoubleKeyFrame KeyTime="0:0:4.6" Value="22"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:4.72" Value="8"/><EasingDoubleKeyFrame KeyTime="0:0:6.0" Value="8"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:6.12" Value="0"/><EasingDoubleKeyFrame KeyTime="0:0:7.2" Value="0"/>
                          </DoubleAnimationUsingKeyFrames>
                          <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Duration="0:0:7.2">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/><EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:1.52" Value="10"/><EasingDoubleKeyFrame KeyTime="0:0:2.9" Value="10"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:3.02" Value="-14"/><EasingDoubleKeyFrame KeyTime="0:0:4.6" Value="-14"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:4.72" Value="16"/><EasingDoubleKeyFrame KeyTime="0:0:6.0" Value="16"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:6.12" Value="0"/><EasingDoubleKeyFrame KeyTime="0:0:7.2" Value="0"/>
                          </DoubleAnimationUsingKeyFrames>
                        </Storyboard></BeginStoryboard>
                      </EventTrigger>
                    </Canvas.Triggers>
                    <Ellipse Canvas.Left="114" Canvas.Top="114" Width="172" Height="172" Fill="#F3EEF6"/>
                    <Ellipse Canvas.Left="136" Canvas.Top="136" Width="128" Height="128" Fill="#6670C0"/>
                    <Ellipse Canvas.Left="142" Canvas.Top="142" Width="116" Height="116" Fill="#2A3070" Stroke="#8DA0FF" StrokeThickness="1.5"/>
                    <Ellipse Canvas.Left="149" Canvas.Top="149" Width="102" Height="102" Fill="#1A1F4D" Stroke="#8DA0FF" StrokeThickness="1"/>
                    <Ellipse Canvas.Left="157" Canvas.Top="157" Width="86" Height="86" Fill="#070A1C"/>
                    <Ellipse Canvas.Left="212" Canvas.Top="214" Width="34" Height="34" Fill="#F4F7FF"/>
                  </Canvas>
                </Canvas>
              </Viewbox>
              <Rectangle Fill="{StaticResource Scanlines}" IsHitTestVisible="False"/>
              <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                  <RadialGradientBrush RadiusX="0.75" RadiusY="0.8"><GradientStop Color="#00000000" Offset="0.6"/><GradientStop Color="#B0000000" Offset="1"/></RadialGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <TextBlock Text="● FAIRY·01" Margin="14,11,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="{DynamicResource Mono}" FontSize="10" Foreground="#AEB9FF"/>
            </Grid>
          </Border>
          <DockPanel Margin="4,8,4,9">
            <Rectangle DockPanel.Dock="Right" Width="7" Height="3" Fill="#7DF0B4" VerticalAlignment="Center"/>
            <TextBlock Text="VISION · LOCAL" FontFamily="{DynamicResource Mono}" FontSize="9" Foreground="#4D5A68"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <TextBlock x:Name="State" Text="Ready when you are" FontSize="24" FontWeight="SemiBold" Margin="0,20,0,10"/>

      <!-- Boot sequence: each check fills in as Vision starts. -->
      <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="CHAT" Style="{StaticResource BootLabel}"/>
        <Line Grid.Column="1" Style="{StaticResource Leader}"/>
        <TextBlock x:Name="ChatStatus" Grid.Column="2" Text="Not checked" Style="{StaticResource BootResult}"/>
      </Grid>
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="CAMERA" Style="{StaticResource BootLabel}"/>
        <Line Grid.Column="1" Style="{StaticResource Leader}"/>
        <TextBlock x:Name="CameraStatus" Grid.Column="2" Text="Not checked" Style="{StaticResource BootResult}"/>
      </Grid>
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="MICROPHONE" Style="{StaticResource BootLabel}"/>
        <Line Grid.Column="1" Style="{StaticResource Leader}"/>
        <TextBlock x:Name="MicrophoneStatus" Grid.Column="2" Text="Not checked" Style="{StaticResource BootResult}"/>
      </Grid>
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="CORE" Style="{StaticResource BootLabel}"/>
        <Line Grid.Column="1" Style="{StaticResource Leader}"/>
        <TextBlock x:Name="CoreStatus" Grid.Column="2" Text="Not checked" Style="{StaticResource BootResult}"/>
      </Grid>
      <TextBlock x:Name="Stage" Margin="0,12,0,0" FontFamily="{DynamicResource Mono}" FontSize="12" Foreground="{DynamicResource Secondary}"/>
      <TextBlock x:Name="Timing" Margin="0,4,0,0" FontFamily="{DynamicResource Mono}" FontSize="11" Foreground="#627487"/>

      <Button x:Name="Primary" Style="{DynamicResource PrimaryAction}" Content="_Start Vision" AutomationProperties.Name="Start Vision"/>

      <WrapPanel>
        <Button x:Name="Cancel" Content="_Cancel startup" Visibility="Collapsed"/>
        <Button x:Name="Stop" Content="S_top Vision" Visibility="Collapsed"/>
        <Button x:Name="Force" Content="_Force stop" Visibility="Collapsed"/>
        <Button x:Name="ChatRecovery" Content="Start c_hat only"/>
      </WrapPanel>
      <TextBlock Text="Chat only leaves camera, microphone, speech and gestures off." FontSize="12" Foreground="{DynamicResource Secondary}"/>

      <Expander x:Name="Details" Header="_Diagnostics" Margin="0,14,0,0" Foreground="{DynamicResource Secondary}">
        <StackPanel Margin="0,10,0,0">
          <TextBlock x:Name="Failure" Text="No startup attempt yet." FontFamily="{DynamicResource Mono}" FontSize="12" Foreground="{DynamicResource Secondary}"/>
          <Button x:Name="Diagnostics" Content="Open _diagnostics folder" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        </StackPanel>
      </Expander>

      <TextBlock x:Name="ProfileStatus" Margin="0,16,0,0" FontSize="12" Foreground="#627487"/>

      <Border x:Name="CloseActions" Visibility="Collapsed" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Stop this app before closing?"/>
          <WrapPanel Margin="0,10,0,0">
            <Button x:Name="CloseCancel" Content="Cancel c_losing"/>
            <Button x:Name="CloseStop" Content="Stop this app and c_lose"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
