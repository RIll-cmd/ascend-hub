<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ascend agents" Width="320" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" ShowActivated="True" Background="#120D0A" BorderBrush="#3A2A1F" BorderThickness="1"
        FontFamily="Consolas" FontSize="11" UseLayoutRounding="True" AutomationProperties.Name="Ascend agents">
  <!-- Static brushes and shapes only: nothing animates or redraws while the remote is closed, and while it shows the
       blink timer only swaps opacities. -->
  <Window.Resources>
    <!-- No signal: grey snow. -->
    <DrawingBrush x:Key="Static" TileMode="Tile" Viewport="0,0,9,6" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#1E1D1B"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,9,6"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#4A4844"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,2,1"/><RectangleGeometry Rect="5,2,1,1"/><RectangleGeometry Rect="2,4,3,1"/><RectangleGeometry Rect="7,5,1,1"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#6B6862"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="3,1,1,1"/><RectangleGeometry Rect="8,3,1,1"/><RectangleGeometry Rect="0,5,1,1"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- CRT scan lines, curved glass and dark corners over every screen. -->
    <DrawingBrush x:Key="Scan" TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#00000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,3"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#26000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,2,4,1"/></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="0.4,1">
      <GradientStop Color="#38FFFFFF" Offset="0"/><GradientStop Color="#0CFFFFFF" Offset="0.42"/><GradientStop Color="#00FFFFFF" Offset="0.43"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Vignette" RadiusX="0.75" RadiusY="0.8">
      <GradientStop Color="#00000000" Offset="0.55"/><GradientStop Color="#70000000" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="Cabinet" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#54412F" Offset="0"/><GradientStop Color="#3A2C21" Offset="0.5"/><GradientStop Color="#2A1F17" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Knob" GradientOrigin="0.35,0.3">
      <GradientStop Color="#C9B8A0" Offset="0"/><GradientStop Color="#5E4E40" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="Brass" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#E8CB8C" Offset="0"/><GradientStop Color="#B8925A" Offset="1"/>
    </LinearGradientBrush>
    <!-- Buttons draw only their background (Tag is the corner radius); focus shows as a light outline. -->
    <Style x:Key="Bare" TargetType="Button">
      <Setter Property="Foreground" Value="#F1EFE8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=7}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#F3D6A6"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.3"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <StackPanel>
    <!-- Header: the ON AIR light, the name, and what Hub and the room use in memory right now. -->
    <DockPanel Margin="12,9,12,7">
      <Border x:Name="OnAir" CornerRadius="3" Padding="5,1" Background="#2A211B" DockPanel.Dock="Left" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="OnAirDot" Width="6" Height="6" Fill="#5F5E5A" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBlock x:Name="OnAirText" Text="ON AIR" FontFamily="Bahnschrift SemiBold" FontSize="10" Foreground="#6B5F55"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="Memory" DockPanel.Dock="Right" Text="" FontSize="10" Foreground="#8F8578" VerticalAlignment="Center"/>
      <TextBlock Text="AGENTS" FontFamily="Bahnschrift SemiBold" FontSize="12" Foreground="#F3D6A6" Margin="8,0,0,0" VerticalAlignment="Center"/>
    </DockPanel>
    <!-- The shelf: a lamp-lit wall, three TVs (Codex, Claude, Antigravity) and a wooden plank with brass name plates. -->
    <Grid>
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2E2119" Offset="0"/><GradientStop Color="#1C140F" Offset="1"/></LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border IsHitTestVisible="False">
        <Border.Background>
          <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.6" RadiusY="1"><GradientStop Color="#30F3D6A6" Offset="0"/><GradientStop Color="#00F3D6A6" Offset="1"/></RadialGradientBrush>
        </Border.Background>
      </Border>
      <StackPanel>
        <UniformGrid Columns="3" Margin="6,10,6,0">
        <Button x:Name="Tv0" Style="{StaticResource Bare}" Margin="3,0" AutomationProperties.Name="Codex">
          <Grid>
            <!-- The glow the TV throws on the wall while it works or calls you. -->
            <Ellipse x:Name="Glow0" Width="120" Height="90" Margin="-20,-6,-20,-10" Opacity="0" IsHitTestVisible="False"/>
            <StackPanel Width="88">
              <Canvas Height="12" Width="88">
                <Line X1="44" Y1="12" X2="31" Y2="1" Stroke="#6B5A4C" StrokeThickness="1.5"/>
                <Line X1="44" Y1="12" X2="57" Y2="1" Stroke="#6B5A4C" StrokeThickness="1.5"/>
                <Ellipse Canvas.Left="29" Canvas.Top="-1" Width="4" Height="4" Fill="#8F7A66"/>
                <Ellipse Canvas.Left="55" Canvas.Top="-1" Width="4" Height="4" Fill="#8F7A66"/>
              </Canvas>
              <Border x:Name="TvBody0" CornerRadius="9" Padding="5" BorderThickness="1.5" BorderBrush="#5C4838" Background="{StaticResource Cabinet}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="13"/></Grid.ColumnDefinitions>
                  <Border x:Name="Screen0" Height="50" CornerRadius="6" Background="#22211E" ClipToBounds="True">
                    <Grid>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="9">
                          <Rectangle x:Name="EyeL0" Width="6" Height="7" RadiusX="3" RadiusY="3" Margin="0,0,10,0" VerticalAlignment="Center"/>
                          <Rectangle x:Name="EyeR0" Width="6" Height="7" RadiusX="3" RadiusY="3" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Path x:Name="Mouth0" Width="10" Height="7" Margin="0,4,0,0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock x:Name="Mark0" FontFamily="Bahnschrift SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,7,0"/>
                      <TextBlock x:Name="NoSignal0" Text="NO SIGNAL" FontSize="8" Foreground="#C9C6BC" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                      <Rectangle Fill="{StaticResource Scan}" IsHitTestVisible="False"/>
                      <Rectangle Fill="{StaticResource Glass}" IsHitTestVisible="False"/>
                      <Rectangle Fill="{StaticResource Vignette}" IsHitTestVisible="False"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Knob}" Margin="0,0,0,5"/>
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Knob}" Margin="0,0,0,8"/>
                    <Ellipse x:Name="Led0" Width="5" Height="5" Fill="#3A3936" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Grid Height="5" Margin="14,0">
                <Rectangle Width="5" Fill="#2A2019" HorizontalAlignment="Left"/>
                <Rectangle Width="5" Fill="#2A2019" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </Grid>
        </Button>
        <Button x:Name="Tv1" Style="{StaticResource Bare}" Margin="3,0" AutomationProperties.Name="Claude">
          <Grid>
            <!-- The glow the TV throws on the wall while it works or calls you. -->
            <Ellipse x:Name="Glow1" Width="120" Height="90" Margin="-20,-6,-20,-10" Opacity="0" IsHitTestVisible="False"/>
            <StackPanel Width="88">
              <Canvas Height="12" Width="88">
                <Line X1="44" Y1="12" X2="31" Y2="1" Stroke="#6B5A4C" StrokeThickness="1.5"/>
                <Line X1="44" Y1="12" X2="57" Y2="1" Stroke="#6B5A4C" StrokeThickness="1.5"/>
                <Ellipse Canvas.Left="29" Canvas.Top="-1" Width="4" Height="4" Fill="#8F7A66"/>
                <Ellipse Canvas.Left="55" Canvas.Top="-1" Width="4" Height="4" Fill="#8F7A66"/>
              </Canvas>
              <Border x:Name="TvBody1" CornerRadius="9" Padding="5" BorderThickness="1.5" BorderBrush="#5C4838" Background="{StaticResource Cabinet}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="13"/></Grid.ColumnDefinitions>
                  <Border x:Name="Screen1" Height="50" CornerRadius="6" Background="#22211E" ClipToBounds="True">
                    <Grid>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="9">
                          <Rectangle x:Name="EyeL1" Width="6" Height="7" RadiusX="3" RadiusY="3" Margin="0,0,10,0" VerticalAlignment="Center"/>
                          <Rectangle x:Name="EyeR1" Width="6" Height="7" RadiusX="3" RadiusY="3" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Path x:Name="Mouth1" Width="10" Height="7" Margin="0,4,0,0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock x:Name="Mark1" FontFamily="Bahnschrift SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,7,0"/>
                      <TextBlock x:Name="NoSignal1" Text="NO SIGNAL" FontSize="8" Foreground="#C9C6BC" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                      <Rectangle Fill="{StaticResource Scan}" IsHitTestVisible="False"/>
                      <Rectangle Fill="{StaticResource Glass}" IsHitTestVisible="False"/>
                      <Rectangle Fill="{StaticResource Vignette}" IsHitTestVisible="False"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Knob}" Margin="0,0,0,5"/>
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Knob}" Margin="0,0,0,8"/>
                    <Ellipse x:Name="Led1" Width="5" Height="5" Fill="#3A3936" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Grid Height="5" Margin="14,0">
                <Rectangle Width="5" Fill="#2A2019" HorizontalAlignment="Left"/>
                <Rectangle Width="5" Fill="#2A2019" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </Grid>
        </Button>
        <Button x:Name="Tv2" Style="{StaticResource Bare}" Margin="3,0" AutomationProperties.Name="Antigravity">
          <Grid>
            <!-- The glow the TV throws on the wall while it works or calls you. -->
            <Ellipse x:Name="Glow2" Width="120" Height="90" Margin="-20,-6,-20,-10" Opacity="0" IsHitTestVisible="False"/>
            <StackPanel Width="88">
              <Canvas Height="12" Width="88">
                <Line X1="44" Y1="12" X2="31" Y2="1" Stroke="#6B5A4C" StrokeThickness="1.5"/>
                <Line X1="44" Y1="12" X2="57" Y2="1" Stroke="#6B5A4C" StrokeThickness="1.5"/>
                <Ellipse Canvas.Left="29" Canvas.Top="-1" Width="4" Height="4" Fill="#8F7A66"/>
                <Ellipse Canvas.Left="55" Canvas.Top="-1" Width="4" Height="4" Fill="#8F7A66"/>
              </Canvas>
              <Border x:Name="TvBody2" CornerRadius="9" Padding="5" BorderThickness="1.5" BorderBrush="#5C4838" Background="{StaticResource Cabinet}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="13"/></Grid.ColumnDefinitions>
                  <Border x:Name="Screen2" Height="50" CornerRadius="6" Background="#22211E" ClipToBounds="True">
                    <Grid>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="9">
                          <Rectangle x:Name="EyeL2" Width="6" Height="7" RadiusX="3" RadiusY="3" Margin="0,0,10,0" VerticalAlignment="Center"/>
                          <Rectangle x:Name="EyeR2" Width="6" Height="7" RadiusX="3" RadiusY="3" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Path x:Name="Mouth2" Width="10" Height="7" Margin="0,4,0,0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock x:Name="Mark2" FontFamily="Bahnschrift SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,7,0"/>
                      <TextBlock x:Name="NoSignal2" Text="NO SIGNAL" FontSize="8" Foreground="#C9C6BC" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                      <Rectangle Fill="{StaticResource Scan}" IsHitTestVisible="False"/>
                      <Rectangle Fill="{StaticResource Glass}" IsHitTestVisible="False"/>
                      <Rectangle Fill="{StaticResource Vignette}" IsHitTestVisible="False"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Knob}" Margin="0,0,0,5"/>
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Knob}" Margin="0,0,0,8"/>
                    <Ellipse x:Name="Led2" Width="5" Height="5" Fill="#3A3936" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Grid Height="5" Margin="14,0">
                <Rectangle Width="5" Fill="#2A2019" HorizontalAlignment="Left"/>
                <Rectangle Width="5" Fill="#2A2019" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </Grid>
        </Button>
        </UniformGrid>
        <Border Height="2" Background="#B07A50"/>
        <Border Height="18">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#8A5A3A" Offset="0"/><GradientStop Color="#5E3C26" Offset="1"/></LinearGradientBrush>
          </Border.Background>
          <UniformGrid Columns="3" Margin="6,0">
          <Border x:Name="Plate0" Background="{StaticResource Brass}" CornerRadius="2" Padding="6,0" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#6E5530">
            <TextBlock Text="CODEX" FontFamily="Bahnschrift SemiBold" FontSize="9" Foreground="#3A2A1F"/>
          </Border>
          <Border x:Name="Plate1" Background="{StaticResource Brass}" CornerRadius="2" Padding="6,0" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#6E5530">
            <TextBlock Text="CLAUDE" FontFamily="Bahnschrift SemiBold" FontSize="9" Foreground="#3A2A1F"/>
          </Border>
          <Border x:Name="Plate2" Background="{StaticResource Brass}" CornerRadius="2" Padding="6,0" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#6E5530">
            <TextBlock Text="AGY" FontFamily="Bahnschrift SemiBold" FontSize="9" Foreground="#3A2A1F"/>
          </Border>
          </UniformGrid>
        </Border>
        <Border Height="6">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#A0000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush>
          </Border.Background>
        </Border>
      </StackPanel>
    </Grid>
    <!-- The lower third for the selected TV; Enter or a click opens it in Hub, the mouse wheel steps through today. -->
    <Button x:Name="Lower" Style="{StaticResource Bare}" Margin="10,4,10,0" Padding="0" HorizontalContentAlignment="Stretch" Background="#1E1813" BorderBrush="#2E241C" Tag="6">
      <Grid Width="295">
        <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Rectangle x:Name="Accent" Fill="#5F5E5A" RadiusX="2" RadiusY="2"/>
        <StackPanel Grid.Column="1" Margin="8,6,8,5">
          <DockPanel Margin="0,0,0,4">
            <TextBlock x:Name="Channel" Text="CH 05" FontSize="10" Foreground="#8F8578" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <Border x:Name="BugPill" CornerRadius="3" Padding="5,1" Background="#2A211B" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="BugDot" Width="6" Height="6" Fill="#888780" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="Bug" Text="IDLE" FontFamily="Bahnschrift SemiBold" FontSize="10" Foreground="#D3D1C7"/>
              </StackPanel>
            </Border>
          </DockPanel>
          <Border x:Name="Banner" Background="#5F5E5A" HorizontalAlignment="Left" Padding="6,1" CornerRadius="2,2,0,0">
            <TextBlock x:Name="Headline" Text="LOOKING IN" FontFamily="Bahnschrift SemiBold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="262"/>
          </Border>
          <Border Background="#F1EFE8" Padding="6,2" CornerRadius="0,2,2,2">
            <TextBlock x:Name="Sub" Text="" Foreground="#2C2C2A" TextTrimming="CharacterEllipsis"/>
          </Border>
          <!-- A coding TV's place in the plan: one segment per task, the running one blinking. -->
          <Grid x:Name="Progress" Height="4" Margin="0,5,0,0" Visibility="Collapsed"/>
          <DockPanel Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button x:Name="Prev" Style="{StaticResource Bare}" FontFamily="Segoe MDL2 Assets" FontSize="9" Content="&#xE76B;" Foreground="#B4B2A9" Padding="5,2" AutomationProperties.Name="Newer session"/>
              <TextBlock x:Name="Position" Text="" FontSize="10" Foreground="#B4B2A9" VerticalAlignment="Center" MinWidth="24" TextAlignment="Center"/>
              <Button x:Name="Next" Style="{StaticResource Bare}" FontFamily="Segoe MDL2 Assets" FontSize="9" Content="&#xE76C;" Foreground="#B4B2A9" Padding="5,2" AutomationProperties.Name="Older session"/>
            </StackPanel>
            <TextBlock x:Name="Today" Text="" FontSize="10" Foreground="#8F8578" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </Grid>
    </Button>
    <!-- +TASK replaces the lower third with a one-line box. -->
    <Border x:Name="TaskPanel" Visibility="Collapsed" Margin="10,4,10,0" Background="#1E1813" BorderBrush="#2E241C" BorderThickness="1.5" CornerRadius="6" Padding="8">
      <StackPanel>
        <TextBlock Text="NEW TASK" FontFamily="Bahnschrift SemiBold" FontSize="10" Foreground="#8F8578" Margin="0,0,0,4"/>
        <TextBox x:Name="TaskText" MaxLength="4000" Background="#F1EFE8" Foreground="#2C2C2A" BorderBrush="#F3D6A6" Padding="5,4" AutomationProperties.Name="New task"/>
        <DockPanel Margin="0,5,0,0">
          <Button x:Name="MoreOptions" Style="{StaticResource Bare}" Content="More options" Foreground="#F3D6A6" DockPanel.Dock="Right" Padding="4,1" AutomationProperties.Name="More options in Hub"/>
          <TextBlock x:Name="TaskHint" Text="Enter starts it" Foreground="#B4B2A9" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </StackPanel>
    </Border>
    <!-- The remote strip. -->
    <Border BorderBrush="#3E3E3A" BorderThickness="1.5" CornerRadius="16" Padding="8,6" Margin="10,8,10,10">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#34342F" Offset="0"/><GradientStop Color="#1F1F1C" Offset="1"/></LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="Pick0" Style="{StaticResource Bare}" Width="20" Height="20" Background="#E28A2B" Tag="10" Margin="0,0,5,0" AutomationProperties.Name="Codex"/>
          <Button x:Name="Pick1" Style="{StaticResource Bare}" Width="20" Height="20" Background="#D97757" Tag="10" Margin="0,0,5,0" AutomationProperties.Name="Claude"/>
          <Button x:Name="Pick2" Style="{StaticResource Bare}" Width="20" Height="20" Background="#3D7BFF" Tag="10" AutomationProperties.Name="Antigravity"/>
        </StackPanel>
        <Button x:Name="Folder" Grid.Column="2" Style="{StaticResource Bare}" Background="#444441" Tag="11" Width="28" Height="22" Margin="0,0,6,0" ToolTip="Open the builds folder" AutomationProperties.Name="Open the builds folder">
          <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#E8E2D6"/>
        </Button>
        <Button x:Name="TaskButton" Grid.Column="3" Style="{StaticResource Bare}" Background="#444441" Tag="11" Height="22" Padding="8,0" Margin="0,0,6,0" AutomationProperties.Name="New task">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#E8E2D6" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock Text="TASK" FontFamily="Bahnschrift SemiBold" FontSize="11" Foreground="#E8E2D6" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="Power" Grid.Column="4" Style="{StaticResource Bare}" Background="#E24B4A" Tag="11" Height="22" Padding="8,0" AutomationProperties.Name="Turn Hub on">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock x:Name="PowerText" Text="HUB" FontFamily="Bahnschrift SemiBold" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </StackPanel>
</Window>
