<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ascend agents" Width="300" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" ShowActivated="True" Background="#1A1410" FontFamily="Consolas" FontSize="11"
        AutomationProperties.Name="Ascend agents">
  <Window.Resources>
    <!-- No signal: thin grey scan lines. -->
    <DrawingBrush x:Key="Static" TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#1A1918"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,3"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#3A3936"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,1"/></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- Flat buttons: the shelf draws its own look, focus shows as a light outline. -->
    <Style x:Key="Flat" TargetType="Button">
      <Setter Property="Foreground" Value="#F1EFE8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#F3D6A6"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Background="#3A2A1F" BorderBrush="#5A3E2A" BorderThickness="4" Padding="8">
    <StackPanel>
      <!-- The shelf: three TVs, Codex, Claude, Antigravity. -->
      <UniformGrid Columns="3">
        <Button x:Name="Tv0" Style="{StaticResource Flat}" Margin="2" Padding="0">
          <StackPanel>
            <Border x:Name="TvBody0" Background="#2C2A26" CornerRadius="5" Padding="3" BorderThickness="2" BorderBrush="Transparent">
              <Border x:Name="Screen0" Height="44" CornerRadius="3" Background="#22211E">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Rectangle x:Name="EyeL0" Width="6" Height="6" RadiusX="3" RadiusY="3" Fill="#3A3936" Margin="0,0,9,0"/>
                  <Rectangle x:Name="EyeR0" Width="6" Height="6" RadiusX="3" RadiusY="3" Fill="#3A3936"/>
                </StackPanel>
              </Border>
            </Border>
            <TextBlock Text="CODEX" Foreground="#F3D6A6" HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
        <Button x:Name="Tv1" Style="{StaticResource Flat}" Margin="2" Padding="0">
          <StackPanel>
            <Border x:Name="TvBody1" Background="#2C2A26" CornerRadius="5" Padding="3" BorderThickness="2" BorderBrush="Transparent">
              <Border x:Name="Screen1" Height="44" CornerRadius="3" Background="#22211E">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Rectangle x:Name="EyeL1" Width="6" Height="6" RadiusX="3" RadiusY="3" Fill="#3A3936" Margin="0,0,9,0"/>
                  <Rectangle x:Name="EyeR1" Width="6" Height="6" RadiusX="3" RadiusY="3" Fill="#3A3936"/>
                </StackPanel>
              </Border>
            </Border>
            <TextBlock Text="CLAUDE" Foreground="#F3D6A6" HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
        <Button x:Name="Tv2" Style="{StaticResource Flat}" Margin="2" Padding="0">
          <StackPanel>
            <Border x:Name="TvBody2" Background="#2C2A26" CornerRadius="5" Padding="3" BorderThickness="2" BorderBrush="Transparent">
              <Border x:Name="Screen2" Height="44" CornerRadius="3" Background="#22211E">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Rectangle x:Name="EyeL2" Width="6" Height="6" RadiusX="3" RadiusY="3" Fill="#3A3936" Margin="0,0,9,0"/>
                  <Rectangle x:Name="EyeR2" Width="6" Height="6" RadiusX="3" RadiusY="3" Fill="#3A3936"/>
                </StackPanel>
              </Border>
            </Border>
            <TextBlock Text="AGY" Foreground="#F3D6A6" HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
      </UniformGrid>
      <Border Height="4" Background="#5A3E2A" Margin="-8,6,-8,6"/>
      <!-- The lower third for the selected TV; Enter or a click opens it in Hub. -->
      <Button x:Name="Lower" Style="{StaticResource Flat}" Padding="2" HorizontalContentAlignment="Stretch">
        <StackPanel Width="264">
          <DockPanel Margin="0,0,0,3">
            <TextBlock x:Name="Channel" Text="CH 05" Foreground="#D3D1C7" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Ellipse x:Name="BugDot" Width="7" Height="7" Fill="#888780" Margin="0,0,4,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="Bug" Text="IDLE" Foreground="#D3D1C7"/>
            </StackPanel>
          </DockPanel>
          <Border x:Name="Banner" Background="#5F5E5A" HorizontalAlignment="Left" Padding="5,1">
            <TextBlock x:Name="Headline" Text="LOOKING IN" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="254"/>
          </Border>
          <Border Background="#F1EFE8" Padding="5,1">
            <TextBlock x:Name="Sub" Text="" Foreground="#2C2C2A" TextTrimming="CharacterEllipsis"/>
          </Border>
        </StackPanel>
      </Button>
      <!-- +TASK replaces the lower third with a one-line box. -->
      <StackPanel x:Name="TaskPanel" Visibility="Collapsed" Margin="2">
        <TextBox x:Name="TaskText" MaxLength="4000" Background="#F1EFE8" Foreground="#2C2C2A" BorderBrush="#F3D6A6" Padding="4,3" AutomationProperties.Name="New task"/>
        <DockPanel Margin="0,4,0,0">
          <Button x:Name="MoreOptions" Style="{StaticResource Flat}" Content="More options" Foreground="#F3D6A6" DockPanel.Dock="Right" Padding="4,0" AutomationProperties.Name="More options in Hub"/>
          <TextBlock x:Name="TaskHint" Text="Enter starts it" Foreground="#D3D1C7" TextWrapping="Wrap"/>
        </DockPanel>
      </StackPanel>
      <!-- The remote strip. -->
      <Border Background="#2C2C2A" BorderBrush="#444441" BorderThickness="2" CornerRadius="10" Padding="6" Margin="-3,8,-3,-3">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="Pick0" Style="{StaticResource Flat}" Width="18" Height="18" Background="#E28A2B" Margin="0,0,4,0" AutomationProperties.Name="Codex"/>
            <Button x:Name="Pick1" Style="{StaticResource Flat}" Width="18" Height="18" Background="#D97757" Margin="0,0,4,0" AutomationProperties.Name="Claude"/>
            <Button x:Name="Pick2" Style="{StaticResource Flat}" Width="18" Height="18" Background="#3D7BFF" AutomationProperties.Name="Antigravity"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="Prev" Style="{StaticResource Flat}" Content="&#x25C0;" Foreground="#B4B2A9" Padding="4,0" AutomationProperties.Name="Newer session"/>
            <TextBlock x:Name="Position" Text="" Foreground="#B4B2A9" VerticalAlignment="Center" MinWidth="26" TextAlignment="Center"/>
            <Button x:Name="Next" Style="{StaticResource Flat}" Content="&#x25B6;" Foreground="#B4B2A9" Padding="4,0" AutomationProperties.Name="Older session"/>
          </StackPanel>
          <Button x:Name="TaskButton" Grid.Column="2" Style="{StaticResource Flat}" Content="+TASK" Background="#444441" Padding="6,2" Margin="0,0,6,0" AutomationProperties.Name="New task"/>
          <Button x:Name="Power" Grid.Column="3" Style="{StaticResource Flat}" Background="#E24B4A" Padding="6,2" AutomationProperties.Name="Turn Hub on">
            <TextBlock x:Name="PowerText" Text="&#x23FB; HUB" Foreground="White"/>
          </Button>
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</Window>
